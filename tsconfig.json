{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "declaration": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "noUnusedLocals": true,
    "outDir": "dist",
    "baseUrl": ".",
    "paths": {
      "scena3d": [
        "./src/index.ts"
      ],
      "scena3d/core": [
        "./src/core.ts"
      ],
      "scena3d/materials": [
        "./src/materials.ts"
      ],
      "scena3d/text": [
        "./src/text.ts"
      ],
      "scena3d/props": [
        "./src/props.ts"
      ],
      "scena3d/environment": [
        "./src/environment.ts"
      ],
      "scena3d/scene": [
        "./src/scene.ts"
      ]
    }
  },
  "include": [
    "src",
    "tests",
    "examples",
    "site"
  ]
}
