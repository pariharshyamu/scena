{
  "name": "scena3d",
  "version": "0.109.0",
  "description": "SCENA — SCenes & ENvironment Assets: a 3D world-building library on top of three.js. Seeded procedural props, terrain, sky and scattering — with gameplay metadata (obstacles, walkability) that game libraries like GAMA understand.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js",
      "require": "./dist/core.cjs"
    },
    "./materials": {
      "types": "./dist/materials.d.ts",
      "import": "./dist/materials.js",
      "require": "./dist/materials.cjs"
    },
    "./text": {
      "types": "./dist/text.d.ts",
      "import": "./dist/text.js",
      "require": "./dist/text.cjs"
    },
    "./props": {
      "types": "./dist/props.d.ts",
      "import": "./dist/props.js",
      "require": "./dist/props.cjs"
    },
    "./environment": {
      "types": "./dist/environment.d.ts",
      "import": "./dist/environment.js",
      "require": "./dist/environment.cjs"
    },
    "./scene": {
      "types": "./dist/scene.d.ts",
      "import": "./dist/scene.js",
      "require": "./dist/scene.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/core.ts src/materials.ts src/text.ts src/props.ts src/environment.ts src/scene.ts --format esm,cjs --dts --sourcemap --clean",
    "dev": "vite examples/forest",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run entries:check && npm run typecheck && npm test && npm run build && npm run size && npm run geometry",
    "dev:manifest": "vite examples/manifest",
    "dev:surfaces": "vite examples/surfaces",
    "dev:market": "vite examples/market",
    "dev:banners": "vite examples/banners",
    "dev:fire": "vite examples/fire",
    "dev:fair": "vite examples/fair",
    "dev:signs": "vite examples/signs",
    "dev:wind": "vite examples/wind",
    "dev:weather": "vite examples/weather",
    "dev:ocean": "vite examples/ocean",
    "dev:flock": "vite examples/flock",
    "dev:herd": "vite examples/herd",
    "dev:underwater": "vite examples/underwater",
    "dev:weathersys": "vite examples/weathersys",
    "dev:surge": "vite examples/surge",
    "dev:trees": "vite examples/trees",
    "dev:seasons": "vite examples/seasons",
    "dev:giants": "vite examples/giants",
    "dev:interior": "vite examples/interior",
    "dev:gallery": "vite examples/gallery",
    "dev:modern": "vite examples/modern",
    "dev:bungalow": "vite examples/bungalow",
    "dev:skyline": "vite examples/skyline",
    "dev:vehicles": "vite examples/vehicles",
    "dev:cricket": "vite examples/cricket",
    "dev:wear": "vite examples/wear",
    "dev:industrial": "vite examples/industrial",
    "dev:physical": "vite examples/physical",
    "dev:environment": "vite examples/environment",
    "site:dev": "node site/build-vendor.mjs && vite site",
    "site:build": "node site/sync-docs.mjs && node site/build-vendor.mjs && vite build site",
    "site:publish": "npm run site:build && node site/publish-docs.mjs",
    "verify:playgrounds": "npm run site:build && node site/verify-playgrounds.mjs",
    "dev:feel": "vite examples/feel",
    "dev:arcade": "vite examples/arcade",
    "entries": "node scripts/entries.mjs",
    "entries:check": "node scripts/entries.mjs --check",
    "size": "node bench/size.mjs",
    "geometry": "node bench/geometry.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pariharshyamu/scena.git"
  },
  "homepage": "https://github.com/pariharshyamu/scena#readme",
  "bugs": {
    "url": "https://github.com/pariharshyamu/scena/issues"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "threejs",
    "procedural",
    "low-poly",
    "terrain",
    "scatter",
    "props",
    "environment",
    "game-development",
    "3d"
  ],
  "license": "MIT",
  "peerDependencies": {
    "three": ">=0.150.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/three": "^0.185.1",
    "@vitest/coverage-v8": "^1.6.1",
    "gama3d": "^0.27.0",
    "playwright": "^1.56.1",
    "three": "^0.185.1",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vite": "^5.2.0",
    "vitest": "^1.6.0"
  }
}
